{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": "Inter, 'Noto Sans Tamil', system-ui, -apple-system, 'Segoe UI', sans-serif" },
      "mono": { "$value": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace" }
    },
    "size": {
      "$type": "dimension",
      "12": { "$value": "12px" },
      "14": { "$value": "14px" },
      "16": { "$value": "16px" },
      "18": { "$value": "18px" },
      "20": { "$value": "20px" },
      "24": { "$value": "24px" },
      "30": { "$value": "30px" },
      "36": { "$value": "36px" },
      "48": { "$value": "48px" }
    },
    "line-height": {
      "$type": "dimension",
      "16": { "$value": "16px" },
      "20": { "$value": "20px" },
      "24": { "$value": "24px" },
      "28": { "$value": "28px" },
      "32": { "$value": "32px" },
      "38": { "$value": "38px" },
      "44": { "$value": "44px" },
      "56": { "$value": "56px" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    }
  }
}
