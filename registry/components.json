      "status": "beta",
      "description": "How far a task has got.",
      "props": {
        "value": "number (empty = indeterminate)",
        "max": "number",
        "label": "ReactNode",
        "showValue": [
          "percent",
          "fraction",
          false
        ],
        "intent": [
          "primary",
          "success",
          "warning",
          "danger"
        ],
        "size": [
          "sm",
          "md",
          "lg"
        ]
      },
      "a11y": [
        "role=progressbar named by the label"
      ],
      "doNot": [
        "Show progress without a label or aria-label"
      ]
    },
