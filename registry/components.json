{
  "$comment": "ARAS component registry. Single source for docs, AI tools and case-study numbers. Update with every component change.",
  "system": "ARAS",
  "version": "0.2.0",
  "tokens": {
    "package": "@tamilarasan/aras-tokens",
    "cssPrefix": "--aras-",
    "brands": [
      "base",
      "lms",
      "food"
    ],
    "themes": [
      "light",
      "dark"
    ],
    "densities": [
      "comfortable",
      "compact"
    ]
  },
  "components": [
    {
      "name": "Button",
      "kind": "primitive",
      "package": "@tamilarasan/aras-ui",
      "import": "import { Button } from '@tamilarasan/aras-ui';",
      "status": "beta",
      "description": "Triggers an action. One primary button per view.",
      "props": {
        "variant": [
          "primary",
          "secondary",
          "tertiary",
          "danger"
        ],
        "size": [
          "sm",
          "md",
          "lg",
          "icon-sm",
          "icon-md",
          "icon-lg"
        ],
        "fullWidth": "boolean",
        "loading": "boolean",
        "asChild": "boolean: render a link or other element with button styles",
        "leftIcon": "ReactNode",
        "rightIcon": "ReactNode"
      },
      "a11y": [
        "Visible focus ring",
        "Min height 28px (compact sm)",
        "aria-busy when loading",
        "Icon-only buttons need aria-label"
      ],
      "doNot": [
        "Two primary buttons in one view",
        "Use danger for non-destructive actions",
        "Use a button for navigation; use asChild with <a>"
      ]
    },
    {
      "name": "Input",
      "kind": "primitive",
      "package": "@tamilarasan/aras-ui",
      "import": "import { Input } from '@tamilarasan/aras-ui';",
      "status": "beta",
      "description": "Single-line text field with label, hint and error.",
      "props": {
        "label": "string (required)",
        "hint": "string",
        "error": "string: what is wrong and how to fix it",
        "hideLabel": "boolean: visually hidden label, for search fields only",
        "size": [
          "sm",
          "md",
          "lg"
        ]
      },
      "a11y": [
        "Label linked with htmlFor",
        "Hint and error linked with aria-describedby",
        "aria-invalid on error",
        "Error has icon + text",
        "Read-only fields look muted but stay readable"
      ],
      "doNot": [
        "Placeholder as the only label",
        "Error messages without a fix"
      ]
    },
    {
      "name": "EmptyState",
      "kind": "pattern",
      "package": "@tamilarasan/aras-patterns",
      "import": "import { EmptyState } from '@tamilarasan/aras-patterns';",
      "status": "beta",
      "description": "Shown when a list, table or page has no data, or a search finds nothing.",
      "props": {
        "title": "string",
        "description": "string",
        "icon": "ReactNode (decorative)",
        "primaryAction": "{ label, onClick?, href? }",
        "secondaryAction": "{ label, onClick?, href? }",
        "headingLevel": [
          "h2",
          "h3",
          "h4"
        ],
        "size": [
          "sm",
          "md",
          "lg"
        ],
        "align": [
          "center",
          "start"
        ]
      },
      "a11y": [
        "Correct heading level",
        "Icon hidden from screen readers"
      ],
      "doNot": [
        "More than one primary action",
        "Blame the user"
      ]
    },
    {
      "name": "Accordion",
      "kind": "primitive",
      "package": "@tamilarasan/aras-ui",
      "import": "import { Accordion, AccordionItem, AccordionTrigger, AccordionContent } from '@tamilarasan/aras-ui';",
      "status": "beta",
      "description": "Stacked sections that expand and collapse.",
      "props": {
        "type": [
          "single",
          "multiple"
        ],
        "variant": [
          "flush",
          "outlined"
        ],
        "AccordionTrigger": "icon?, meta?, headingLevel?"
      },
      "a11y": [
        "Triggers are buttons inside headings",
        "Arrow keys move between triggers",
        "Respects reduced motion"
      ],
      "doNot": [
        "Hide essential content in a closed section",
        "Nest accordions"
      ]
    },
    {
      "name": "Avatar",
      "kind": "primitive",
      "package": "@tamilarasan/aras-ui",
      "import": "import { Avatar, AvatarGroup } from '@tamilarasan/aras-ui';",
      "status": "beta",
      "description": "Person or organisation image with initials fallback, status and notification count. AvatarGroup stacks avatars.",
      "props": {
        "name": "string (required)",
        "src": "string",
        "size": [
          "xs",
          "sm",
          "md",
          "lg",
          "xl"
        ],
        "shape": [
          "circle",
          "square"
        ],
        "status": [
          "online",
          "away",
          "busy",
          "offline"
        ],
        "notificationCount": "number"
      },
      "a11y": [
        "name is the accessible name",
        "Status announced in words"
      ],
      "doNot": [
        "Use colour alone for status"
      ]
    },
    {
      "name": "Badge",
      "kind": "primitive",
      "package": "@tamilarasan/aras-ui",
      "import": "import { Badge } from '@tamilarasan/aras-ui';",
      "status": "beta",
      "description": "Compact pill for counts and status.",
      "props": {
        "intent": [
          "neutral",
          "primary",
          "success",
          "warning",
          "danger",
          "info"
        ],
        "emphasis": [
          "soft",
          "solid",
          "outline"
        ],
        "size": [
          "sm",
          "md"
        ],
        "dot": "boolean",
        "srLabel": "string"
      },
      "a11y": [
        "Always has text",
        "srLabel adds context to bare numbers"
      ],
      "doNot": [
        "Use for filter tags (use Chip)"
      ]
    },
    {
      "name": "Breadcrumb",
      "kind": "primitive",
      "package": "@tamilarasan/aras-ui",
      "import": "import { Breadcrumb, BreadcrumbList, BreadcrumbItem, BreadcrumbLink, BreadcrumbPage, BreadcrumbSeparator } from '@tamilarasan/aras-ui';",
      "status": "beta",
      "description": "Trail of ancestor pages.",
      "props": {
        "parts": "Breadcrumb > BreadcrumbList > BreadcrumbItem > BreadcrumbLink | BreadcrumbPage, BreadcrumbSeparator, BreadcrumbEllipsis"
      },
      "a11y": [
        "nav landmark with ordered list",
        "Current page has aria-current=page and is not a link"
      ],
      "doNot": [
        "Link the current page"
      ]
    },
    {
      "name": "Checkbox",
      "kind": "primitive",
      "package": "@tamilarasan/aras-ui",
      "import": "import { Checkbox, CheckboxField } from '@tamilarasan/aras-ui';",
      "status": "beta",
      "description": "Choose zero or more options. CheckboxField adds label, description and card layout.",
      "props": {
        "checked": "boolean | 'indeterminate'",
        "size": [
          "sm",
          "md"
        ],
        "invalid": "boolean",
        "CheckboxField": "label, description?, meta?, card?"
      },
      "a11y": [
        "Visible label",
        "aria-checked=mixed for indeterminate",
        "Space toggles"
      ],
      "doNot": [
        "Use for settings that apply immediately (use Switch)"
      ]
    },
    {
      "name": "Chip",
      "kind": "primitive",
      "package": "@tamilarasan/aras-ui",
      "import": "import { Chip } from '@tamilarasan/aras-ui';",
      "status": "beta",
      "description": "Small label for status, metadata and filter tags, with optional icon and remove button.",
      "props": {
        "intent": [
          "neutral",
          "primary",
          "success",
          "warning",
          "danger",
          "info"
        ],
        "emphasis": [
          "soft",
          "solid",
          "outline"
        ],
        "size": [
          "sm",
          "md"
        ],
        "icon": "ReactNode",
        "onRemove": "() => void"
      },
      "a11y": [
        "Remove button named 'Remove <label>'",
        "Text truncates instead of breaking layout"
      ],
      "doNot": [
        "Use colour alone to show meaning"
      ]
    },
    {
      "name": "Collapsible",
      "kind": "primitive",
      "package": "@tamilarasan/aras-ui",
      "import": "import { Collapsible } from '@tamilarasan/aras-ui';",
      "status": "beta",
      "description": "One section that shows and hides extra content.",
      "props": {
        "title": "ReactNode (required)",
        "variant": [
          "plain",
          "outlined",
          "card"
        ],
        "size": [
          "sm",
          "md"
        ]
      },
      "a11y": [
        "Trigger has aria-expanded"
      ],
      "doNot": [
        "Use for several sections (use Accordion)"
      ]
    },
    {
      "name": "FileField",
      "kind": "primitive",
      "package": "@tamilarasan/aras-ui",
      "import": "import { FileField } from '@tamilarasan/aras-ui';",
      "status": "beta",
      "description": "File picker styled like Input; the native input stays in the page.",
      "props": {
        "label": "string (required)",
        "hint": "string",
        "error": "string",
        "accept": "string",
        "multiple": "boolean",
        "size": [
          "sm",
          "md",
          "lg"
        ]
      },
      "a11y": [
        "Native input keeps keyboard and screen reader support",
        "Chosen file announced politely"
      ],
      "doNot": [
        "Hide the label"
      ]
    },
    {
      "name": "Kbd",
      "kind": "primitive",
      "package": "@tamilarasan/aras-ui",
      "import": "import { Kbd } from '@tamilarasan/aras-ui';",
      "status": "beta",
      "description": "Keyboard key for shortcuts.",
      "props": {
        "size": [
          "sm",
          "md"
        ]
      },
      "a11y": [
        "Native <kbd> element",
        "Give symbols a readable title"
      ],
      "doNot": [
        "Put several keys in one Kbd"
      ]
    },
    {
      "name": "LoadingButton",
      "kind": "primitive",
      "package": "@tamilarasan/aras-ui",
      "import": "import { LoadingButton } from '@tamilarasan/aras-ui';",
      "status": "beta",
      "description": "Button that runs an async action and shows loading, success and error states.",
      "props": {
        "onAction": "() => Promise (required)",
        "loadingLabel": "string",
        "successLabel": "string",
        "errorLabel": "string",
        "countdown": "seconds, cancellable",
        "autoResetMs": "number"
      },
      "a11y": [
        "State changes announced in a live region",
        "aria-busy while loading"
      ],
      "doNot": [
        "Reimplement loading states by hand"
      ]
    },
    {
      "name": "Pagination",
      "kind": "primitive",
      "package": "@tamilarasan/aras-ui",
      "import": "import { Pagination } from '@tamilarasan/aras-ui';",
      "status": "beta",
      "description": "Page n of m with Previous/Next and optional page numbers.",
      "props": {
        "page": "number",
        "pageCount": "number",
        "onPageChange": "(page) => void",
        "showPageNumbers": "boolean",
        "siblingCount": "number"
      },
      "a11y": [
        "nav landmark",
        "aria-current=page on the active page"
      ],
      "doNot": [
        "Hide Previous/Next when disabled"
      ]
    },
    {
      "name": "Popover",
      "kind": "primitive",
      "package": "@tamilarasan/aras-ui",
      "import": "import { Popover, PopoverTrigger, PopoverContent } from '@tamilarasan/aras-ui';",
      "status": "beta",
      "description": "Small floating panel for info, quick settings or a short form.",
      "props": {
        "PopoverContent": "wide?, showClose?, arrow?",
        "parts": "PopoverBody, PopoverTitle, PopoverDescription, PopoverFooter"
      },
      "a11y": [
        "Focus moves in and returns",
        "Esc and outside click close"
      ],
      "doNot": [
        "Use for long or blocking tasks (use Modal)"
      ]
    },
    {
      "name": "Progress",
      "kind": "primitive",
      "package": "@tamilarasan/aras-ui",
